# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# ==========================================
# JUPYTER NOTEBOOK
# ==========================================
.ipynb_checkpoints
*.ipynb

# ==========================================
# DATASETS (NO SUBIR - 7.46 GB TOTAL)
# ==========================================
datasets/

# ==========================================
# DATOS PROCESADOS (NO SUBIR - 0.70 GB)
# ==========================================
datos/procesados/
datos/crudo/

# ==========================================
# MODELOS (SE DESCARGAN DE GOOGLE DRIVE)
# ==========================================
modelos/**/*.h5
modelos/**/*.keras
modelos/**/*.pb
modelos/**/*.weights
modelos/deteccion/logs/
modelos/segmentacion/logs/
modelos/deteccion/backup_old/
modelos/segmentacion/backup_old/

# Permitir archivos JSON de métricas
!modelos/**/*.json

# Resultados (imágenes generadas - pueden regenerarse con scripts)
resultados/visualizaciones/
resultados/analisis_parametros/

