.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs de entrenamiento de modelos (NO los logs de documentación)
resultados/logs/
*.log

# Archivos temporales
*.tmp
*.bak
*~

# Archivos específicos de Windows
$RECYCLE.BIN/
*.lnk
